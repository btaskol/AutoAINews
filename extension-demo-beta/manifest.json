{
  "manifest_version": 3,
  "name": "Brief",
  "version": "1.0.9",
  "key": "",
  "description": "Public beta of Brief: save web pages, get grounded summaries, and build a searchable library.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "identity",
    "offscreen"
  ],
  "host_permissions": [
    "https://beta.brieflykeep.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Summarize Page (Beta)",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://beta.brieflykeep.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
