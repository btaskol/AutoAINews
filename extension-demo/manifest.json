{
  "manifest_version": 3,
  "name": "Brief",
  "version": "1.0.0",
  "description": "AI-powered executive summaries and personal web captures.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "identity"
  ],
  "host_permissions": [
    "https://brief.berkaytaskol.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Summarize Page"
  }
}
