{
  "manifest_version": 3,
  "name": "AI Intelligence Capture",
  "version": "1.1",
  "permissions": ["activeTab", "scripting", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "Open AI Side Panel"
  }
}
