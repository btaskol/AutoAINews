{
  "name": "brief-dev-tag-filters",
  "main": "src/index.js",
  "compatibility_date": "2024-01-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "dev.brieflykeep.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "READ_ONLY": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brief-dev-tag-filters-db",
      "database_id": "a29eba23-2e52-423d-9e90-34ca80afebcb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "brief-dev-tag-filters-snapshots"
    }
  ]
}
